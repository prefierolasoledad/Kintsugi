# Copy to .env.local and adjust. .env.local is gitignored; this file is not, so
# never put a real secret here.

# Where the Next.js route handlers proxy to. This is a server-only variable —
# the browser never talks to the API directly, which is the point of the BFF.
# See docs/adr/0002-bff-proxy.md
BACKEND_URL=http://localhost:4000

# --- Stripe ------------------------------------------------------------------
# Publishable key, for the Stripe.js flow where the browser confirms the payment
# and our server never handles a card. Safe to expose: it can create and confirm
# payments, not read or refund them.
#
# Anything named NEXT_PUBLIC_* is inlined into the client bundle, so the SECRET
# key must never be given this prefix — or put in this project's frontend at all.
# It belongs only in backend/.env.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
