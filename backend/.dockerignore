# Everything the build does not need. This file is not housekeeping — the build
# context is uploaded to the daemon in full, so a missed entry means node_modules
# is copied on every build and the layer cache is invalidated by a file the
# image never uses.

node_modules
dist

# Generated inside the image by `prisma generate`. Copying a host-generated
# client would bake in binaries built for the developer's platform.
src/generated

# Tests, and the artefacts they leave. Playwright alone is ~400MB installed;
# none of it belongs in a runtime image.
tests
probe-*.ts
verify-*.ts

# Real secrets. The image reads configuration from the environment.
.env
.env.*
!.env.example

# Seller uploads live on a volume, not in the image.
uploads

npm-debug.log*
.DS_Store
