# Postgres. Port 5433 matches docker-compose.yml, which maps the container's
# 5432 to 5433 on the host to avoid clashing with a native Postgres install.
DATABASE_URL="postgresql://kintsugi:kintsugi@localhost:5433/kintsugi?schema=public"

# Signs access tokens. Use a long random string; rotating it invalidates every
# active session.
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Allowed CORS origin, and the base URL used to build email verification links.
FRONTEND_ORIGIN="http://localhost:3000"

# --- Uploads -----------------------------------------------------------------
# Where seller photos are written, and the public base URL they're served from.
# Defaults suit local development; point these at object storage / a CDN in
# production. See docs/architecture/lld.md for the storage seam.
# UPLOAD_DIR="./uploads"
# PUBLIC_UPLOAD_BASE="http://localhost:4000/uploads"

# --- Identity verification ---------------------------------------------------
# "stub"            — deterministic fake. Decides from a document number that
#                     passes through memory and is never stored.
# "stripe_identity" — real Stripe Identity. The seller uploads on Stripe's own
#                     domain, so no document reaches this process at all.
#                     Reuses STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET below
#                     — no second account needed.
#
# Note the stub is the WEAKER privacy model: it has to see a document number to
# decide anything. Switching to a real provider removes that field entirely.
# See docs/adr/0006-kyc-store-reference-not-document.md
KYC_PROVIDER="stub"

# --- Payments ----------------------------------------------------------------
# "stub"   — no account needed. An in-process PaymentIntent state machine with
#            deterministic outcomes. Restarting the server forgets its intents,
#            which reconciliation handles as "no charge exists".
# "stripe" — real Stripe test mode. Needs BOTH keys below; the server refuses to
#            start with "stripe" and either one missing.
# See docs/adr/0013-payment-provider-seam.md
PAYMENT_PROVIDER="stub"

# TEST KEYS ONLY. Dashboard > Developers > API keys, with test mode on.
# The server refuses to start with a live key outside production, because a live
# key in development takes real money.
# STRIPE_SECRET_KEY="sk_test_..."

# Signs incoming webhooks. Without it the webhook endpoint is an
# unauthenticated "mark my order paid" button, so it is required rather than
# optional whenever PAYMENT_PROVIDER=stripe.
#
# Get one locally with:
#   stripe listen --forward-to localhost:4000/webhooks/stripe
# which prints a whsec_... secret for that session. It changes each time you
# start `stripe listen`, so expect to update this.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Test card numbers (both providers, by last four digits) ------------------
#   4242 4242 4242 4242  succeeds
#   4000 0000 0000 0002  declined
#   4000 0000 0000 0069  expired card
#   4000 0000 0000 0119  processing error
#   4000 0025 0000 3155  requires authentication (3-D Secure)
# In Stripe mode these are mapped to Stripe test payment-method tokens before
# the API call, so no card number ever leaves the process.

# --- Email -------------------------------------------------------------------
# MAIL_TRANSPORT picks how verification emails leave the building.
#
# "console"  (default) prints the link to this terminal. Nothing is sent. This
#            is what the test suites run against — 619 assertions should not
#            depend on an SMTP handshake.
# "ethereal" creates a throwaway inbox on demand and really sends to it. The
#            log line carries a URL where the rendered email can be read. No
#            account, no cost, no setup. Use this to demo or film the flow.
# "smtp"     a real server. Requires SMTP_HOST, SMTP_USER, SMTP_PASS, and the
#            server refuses to start without them rather than failing at the
#            first signup.
MAIL_TRANSPORT=console

# Shown as the sender. Real providers reject a From address on a domain you do
# not control, so set this to something you own before using "smtp".
MAIL_FROM=Kintsugi <no-reply@kintsugi.local>

# Only read when MAIL_TRANSPORT=smtp.
# Port defaults to 587. SMTP_SECURE defaults to true on 465 and false elsewhere,
# which is the right answer for almost every provider.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_SECURE=

# --- Notification delivery ---------------------------------------------------
# How events get from the outbox to the channel workers.
#
# "inline" (default) — the API runs the relay itself and calls the consumer
#          functions in-process. No broker, nothing extra to run. This is what
#          the test suite and CI use: 870 assertions should not wait on a Kafka
#          cluster, and a pull request from a fork must pass without one.
#
#          It is NOT a stub. The outbox write, the transaction it shares with
#          the notification, the relay's FOR UPDATE SKIP LOCKED claim, and the
#          consumer handlers all run exactly as they do in production. Only the
#          wire is missing.
#
# "kafka"  — the real transport. The relay and workers run as their own
#            processes (npm run relay / npm run worker) and the API does not
#            relay at all.
#
# See docs/adr/0024-outbox-not-dual-writes.md
NOTIFY_TRANSPORT=inline

# Comma-separated. Required when NOTIFY_TRANSPORT=kafka; the server refuses to
# start without it rather than piling notifications up in the outbox while
# reporting healthy.
# KAFKA_BROKERS=localhost:9092

# Read from here rather than hardcoded, because a literal is wrong in one
# direction or the other in every environment: 1 and 1 on a single-broker
# compose stack, 3 and 2 on a real cluster. A hardcoded 3 makes local topic
# creation fail; a hardcoded 1 makes production silently unreplicated.
# KAFKA_REPLICATION_FACTOR=1
# KAFKA_MIN_INSYNC_REPLICAS=1

# How long the relay waits after finding an empty outbox. A pass that found work
# goes straight round again, so this is idle latency, not throughput.
# RELAY_POLL_MS=1000

# --- Push notifications ------------------------------------------------------
# Web Push (VAPID). Generate a pair with:
#
#   npm run push:keys
#
# Without them nobody can subscribe, push is reported as "not configured" at
# startup, and every push delivery is recorded as SUPPRESSED rather than failed.
# Nothing else breaks — email and in-app are unaffected.
#
# ROTATING THESE INVALIDATES EVERY EXISTING SUBSCRIPTION: the public half is
# baked into each browser's subscription when it is created. Generate once per
# environment and keep it.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# The contact address in the VAPID claim. Push services use it to reach an
# operator whose sender is misbehaving, before they start rejecting it.
# VAPID_SUBJECT=mailto:you@example.com

# --- SMS ---------------------------------------------------------------------
# stub   nothing is sent, no secret is needed, and the code is returned by
#        /notifications/phone/start so the flow can be finished without a
#        handset. The default, and what CI runs.
# twilio the real thing. Every message costs money and arrives on somebody's
#        lock screen, so this is never the default.
SMS_PROVIDER=stub

# Twilio credentials. Required when SMS_PROVIDER=twilio; the server refuses to
# start without them rather than discovering it on the first refund.
# The auth token is a password — it is not a publishable key, and anything
# holding it can send messages billed to this account.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=

# A sender. Prefer the Messaging Service: it carries sender pools, per-country
# sender selection, and Twilio's own STOP/START handling — so an opt-out is
# honoured by the provider even if a bug here would have sent anyway.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Or a single number you own, E.164. Used only when no messaging service is set.
# TWILIO_FROM_NUMBER=+15005550006

# Hours in which SMS is not sent, as HH:MM-HH:MM. Wraps midnight. "off"
# disables it. A message caught by the window is NOT dropped — it is parked on
# the ledger and sent when the window opens.
#
# NOTE: this is the SERVER's window, not the recipient's. There is no timezone
# column on User yet, so a user abroad is quiet during this zone's night rather
# than their own.
# SMS_QUIET_HOURS=22:00-08:00
# SMS_QUIET_HOURS_TZ=UTC

# Messages per user per day, across every event type. A circuit breaker against
# a loop or a bulk action, not a user preference.
# SMS_DAILY_CAP=10

# How long a message parked by quiet hours may wait before it is dropped
# instead of sent. For the case where the sweeper itself was down, not the
# ordinary overnight wait — a refund text two days late re-alarms somebody
# about something already resolved.
# SMS_DEFER_MAX_AGE_HOURS=24

# --- Paying sellers -----------------------------------------------------------
# stub           no money moves, no secret needed, and the onboarding flow can
#                be completed from our own frontend. The default, and what CI runs.
# stripe_connect real Connect Express accounts and real transfers.
#
# Needs STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (above): whether an account
# can actually receive money arrives only as an account.updated webhook, so
# without it no seller is ever marked ready to be paid.
PAYOUT_PROVIDER=stub

# How long after DELIVERY an item has to sit before it can be paid out.
#
# A guess, and stated as one: long enough that the ordinary refund arrives
# first, short enough that a seller is not financing the platform. The right
# number needs dispute data nobody has yet.
# See docs/adr/0030-payout-eligibility-and-hold.md
# PAYOUT_HOLD_DAYS=7

# How long after DELIVERY a buyer may still ask for a return.
#
# DEFAULTS TO PAYOUT_HOLD_DAYS, and leaving it unset is the safe choice.
#
# The payout hold exists so the platform does not send a seller money that is
# about to be clawed back. A return window LONGER than that hold means every
# return opened after the hold expires lands on money already transferred — so
# the transfer-reversal path, which exists for the rare case, becomes the
# ordinary one. Two numbers picked independently that have to relate to each
# other will not stay related, so this one derives from the other.
#
# Raising it above the hold is allowed and buyer-friendly. The boot banner then
# says plainly that late returns will need reversals.
# See docs/adr/0031-buyer-initiated-returns.md
# RETURN_WINDOW_DAYS=7

# --- Operations -------------------------------------------------------------
# Consumer lag above which GET /health/lag answers 503. Generous on purpose:
# measured throughput is 109-189 events/sec per group, so 5,000 is roughly half
# a minute of backlog — well above a normal burst, well below the point where
# somebody's refund notice is an hour old.
# NOTIFY_LAG_THRESHOLD=5000

# Dead-letter depth above which the same endpoint answers 503. One message in
# the DLQ is usually a bad address; a DLQ that is GROWING is the incident.
# NOTIFY_DLQ_THRESHOLD=100

# How long a published outbox row is kept. Matches the main topic's retention
# (7 days) because a published row has exactly one use left — republishing an
# event Kafka lost — and once the broker has dropped it, that use is gone.
# UNPUBLISHED rows are never deleted at any age: one of those is work still
# owed, and deleting it destroys the notification and the evidence together.
# OUTBOX_RETENTION_HOURS=168

# How long a delivery may sit at PENDING before it is presumed abandoned. A row
# is legitimately PENDING for as long as a provider call takes, so this is far
# beyond any real call and far short of anyone noticing a missing notification.
#
# Past it, the per-channel policy of ADR 0026 applies: email and push are
# RESENT (a duplicate is an annoyance, a missing refund notice is not), SMS is
# FAILED for a human (a duplicate text costs money and reads as a phishing
# retry).
# DELIVERY_STALE_MINUTES=10

# Set to false to stop the API running the outbox relay in-process on the
# inline transport. Exists for the test suite: tests/api/outbox.ts drives the
# relay by hand, and one ticking in the API claims the same rows and reports
# "one event published — 0". Leave it alone outside a test run.
# RELAY_IN_PROCESS=true
