# Postgres. Port 5433 matches docker-compose.yml, which maps the container's
# 5432 to 5433 on the host to avoid clashing with a native Postgres install.
DATABASE_URL="postgresql://kintsugi:kintsugi@localhost:5433/kintsugi?schema=public"

# Signs access tokens. Use a long random string; rotating it invalidates every
# active session.
JWT_SECRET="replace-with-a-long-random-string"

PORT=4000

# Allowed CORS origin, and the base URL used to build email verification links.
FRONTEND_ORIGIN="http://localhost:3000"

# --- Uploads -----------------------------------------------------------------
# Where seller photos are written, and the public base URL they're served from.
# Defaults suit local development; point these at object storage / a CDN in
# production. See docs/architecture/lld.md for the storage seam.
# UPLOAD_DIR="./uploads"
# PUBLIC_UPLOAD_BASE="http://localhost:4000/uploads"

# --- Identity verification ---------------------------------------------------
# "stub" runs a deterministic fake so development never handles real ID
# documents. Any other value requires implementing that provider in
# src/lib/kycProvider.ts. See docs/adr/0006-kyc-store-reference-not-document.md
KYC_PROVIDER="stub"

# --- Payments ----------------------------------------------------------------
# "stub"   — no account needed. An in-process PaymentIntent state machine with
#            deterministic outcomes. Restarting the server forgets its intents,
#            which reconciliation handles as "no charge exists".
# "stripe" — real Stripe test mode. Needs BOTH keys below; the server refuses to
#            start with "stripe" and either one missing.
# See docs/adr/0013-payment-provider-seam.md
PAYMENT_PROVIDER="stub"

# TEST KEYS ONLY. Dashboard > Developers > API keys, with test mode on.
# The server refuses to start with a live key outside production, because a live
# key in development takes real money.
# STRIPE_SECRET_KEY="sk_test_..."

# Signs incoming webhooks. Without it the webhook endpoint is an
# unauthenticated "mark my order paid" button, so it is required rather than
# optional whenever PAYMENT_PROVIDER=stripe.
#
# Get one locally with:
#   stripe listen --forward-to localhost:4000/webhooks/stripe
# which prints a whsec_... secret for that session. It changes each time you
# start `stripe listen`, so expect to update this.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Test card numbers (both providers, by last four digits) ------------------
#   4242 4242 4242 4242  succeeds
#   4000 0000 0000 0002  declined
#   4000 0000 0000 0069  expired card
#   4000 0000 0000 0119  processing error
#   4000 0025 0000 3155  requires authentication (3-D Secure)
# In Stripe mode these are mapped to Stripe test payment-method tokens before
# the API call, so no card number ever leaves the process.
