generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a listing. Most goods here are one-of-a-kind, so the
/// important guarantee is "nobody else can buy this one", not a stock count.
/// RESERVED exists so checkout can hold a unique item without selling it twice.
enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  REMOVED
}

/// Constrained so buyers can actually filter on it. The seller's own wording
/// lives in Listing.conditionNote, which is what the UI shows.
enum Condition {
  LIKE_NEW
  GOOD
  WELL_LOVED
  NEEDS_REPAIR
}

enum VerificationStatus {
  UNSTARTED
  PENDING
  VERIFIED
  REJECTED
}

/// A hold placed on stock while a buyer completes checkout.
/// HELD is the only state that consumes availability.
enum ReservationStatus {
  HELD
  RELEASED
  CONVERTED
  EXPIRED
}

/// PENDING_PAYMENT and PROCESSING keep stock committed. Anything else has
/// either taken the money or given the stock back.
///
/// PROCESSING is the mutual-exclusion mechanism for payment. A request claims
/// the order by moving it PENDING_PAYMENT -> PROCESSING in one conditional
/// UPDATE; only the request whose UPDATE matched a row may call the provider.
/// Without it, two concurrent clicks both read PENDING_PAYMENT, both pass the
/// status check, and both charge the card.
/// See docs/adr/0013-payment-provider-seam.md
enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// What a notification is about.
///
/// Every value corresponds to something that ACTUALLY HAPPENED to this user —
/// their item sold, their parcel moved, a decision landed on their account.
/// Nothing here is marketing. A notification list that mixes "your order
/// shipped" with "check out our new arrivals" trains people to ignore both.
enum NotificationType {
  /// Seller: someone bought your item.
  SALE_MADE
  /// Buyer: the seller has sent it.
  ORDER_SHIPPED
  /// Seller: the buyer confirmed it arrived.
  ORDER_DELIVERED
  /// Buyer: the seller cannot send it after all.
  ORDER_UNFULFILLABLE
  /// Seller: someone reviewed something you sold.
  REVIEW_RECEIVED
  IDENTITY_VERIFIED
  IDENTITY_REJECTED
  /// Buyer: money has been sent back.
  REFUND_ISSUED
  /// Moderation outcomes, addressed to whoever they affect.
  LISTING_REMOVED
  ACCOUNT_SUSPENDED
  REPORT_RESOLVED
  /// Seller or moderator: the other side replied on a thread (ADR 0033).
  MESSAGE_RECEIVED
  /// Seller: their homepage placement request was answered (ADR 0034).
  PLACEMENT_DECIDED
}

/// Who someone is on the platform.
///
/// A flag rather than a permissions table: there are two kinds of person here,
/// and inventing a role system for two roles is how you end up maintaining one.
enum UserRole {
  USER
  ADMIN
}

/// What a report is about. The target id is not a foreign key — a report must
/// survive the thing it reported being deleted, which is often the outcome.
enum ReportTargetType {
  LISTING
  USER
  REVIEW
}

/// Constrained so reports can be triaged and counted. The reporter's own words
/// go in Report.detail, which is what a moderator actually reads.
enum ReportReason {
  PROHIBITED_ITEM
  COUNTERFEIT
  MISLEADING_DESCRIPTION
  SPAM
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  /// Looked at, nothing wrong. Distinct from RESOLVED so "we did nothing" is
  /// recorded as a decision rather than looking like an unfinished queue item.
  DISMISSED
}

/// What a moderator did, and why.
enum ModerationActionType {
  LISTING_REMOVED
  LISTING_RESTORED
  USER_SUSPENDED
  USER_REINSTATED
  REVIEW_REMOVED
  REPORT_DISMISSED
}

/// How a refund is going, at the provider.
///
/// PENDING exists for the same reason OrderStatus.PROCESSING does: the request
/// has been sent and we do not yet know the answer. A refund that is assumed to
/// have worked is how a buyer ends up told their money is back when it is not.
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Who decided to give the money back.
///
/// Recorded because "the seller could not send it" and "a moderator overruled a
/// dispute" are different events with different follow-ups, and six months later
/// the refund row is the only place that distinction still exists.
enum RefundTrigger {
  /// A seller marked their line unfulfillable. Issued automatically.
  SELLER_UNFULFILLABLE
  /// A moderator issued it from the admin panel.
  ADMIN
  /// A return the buyer asked for and the seller or a moderator approved.
  /// The request itself lives in ReturnRequest; by the time a Refund exists
  /// the decision has already been made. See ADR 0031.
  BUYER_RETURN
}

/// Where a return request has got to.
///
/// OPEN is the only state the seller can answer from, and REFUSED the only one
/// the buyer can escalate from — every transition is a conditional UPDATE on
/// the current value, so two concurrent answers cannot both win.
enum ReturnStatus {
  /// Asked. The seller has not answered.
  OPEN
  /// Answered yes. A Refund exists and refundId points at it.
  APPROVED
  /// Answered no by the seller. The buyer may escalate.
  REFUSED
  /// The buyer asked a moderator to look at a refusal.
  ESCALATED
  /// A moderator agreed with the seller. Terminal.
  REJECTED
  /// The buyer changed their mind about asking. Terminal.
  WITHDRAWN
}

/// Whether an item has actually been sent.
///
/// DELIBERATELY SEPARATE FROM OrderStatus
/// Payment and delivery are independent facts: an order is PAID *and*
/// UNFULFILLED for as long as it takes the seller to reach a post office, and
/// one enum cannot hold both. Folding them together is how systems end up with
/// states like "PAID_BUT_ALSO_SHIPPED".
///
/// It lives on OrderItem rather than Order because a basket can span several
/// sellers, and two sellers cannot share one parcel. Each line is fulfilled by
/// whoever sold it.
enum FulfilmentStatus {
  UNFULFILLED
  SHIPPED
  DELIVERED
  /// The seller could not send it. Distinct from a payment failure.
  UNFULFILLABLE
}

model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  passwordHash       String
  name               String
  isSeller           Boolean                  @default(false)
  emailVerified      Boolean                  @default(false)
  /// Public URL of the processed avatar, or null to fall back to initials.
  /// The image itself lives in object storage, never in this database —
  /// see docs/adr/0011-avatars-in-object-storage.md
  avatarUrl          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  refreshTokens      RefreshToken[]
  verificationTokens EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  sellerProfile      SellerProfile?
  reviews            Review[]
  reservations       Reservation[]
  /// Two kinds of person, so a flag rather than a permissions table.
  role               UserRole                 @default(USER)

  /// SUSPENSION, NOT DELETION
  /// A suspended account cannot log in, but its listings, orders, and reviews
  /// stay exactly where they are. Deleting a bad actor would also delete the
  /// evidence, and would orphan the orders of people who bought from them in
  /// good faith.
  suspendedAt     DateTime?
  /// Shown to them at the login screen. Vague suspensions are indistinguishable
  /// from bugs, and generate support instead of preventing it.
  suspendedReason String?

  /// TOTP, for admins only.
  ///
  /// WHY TOTP AND NOT SMS OR EMAIL
  /// SMS is vulnerable to SIM-swap, which is a real attack against exactly the
  /// kind of account that has admin rights. Emailed codes are only as strong as
  /// the inbox — and the inbox is also where a password reset lands, so one
  /// compromise would hand over both factors at once. TOTP depends on neither:
  /// an authenticator app and a shared secret, stronger than both.
  ///
  /// The secret is stored raw because it has to be: verifying a code requires
  /// recomputing it, so there is no hashed form that would still work. That is
  /// a real limitation of TOTP, and the mitigation is that it is only ever set
  /// for admin accounts, of which there should be very few.
  totpSecret      String?
  /// Null until a code has been entered correctly. An enrolment that was
  /// started but never confirmed must not be treated as a second factor.
  totpConfirmedAt DateTime?
  /// REPLAY PROTECTION: the start of the 30-second period whose code was last
  /// accepted.
  ///
  /// A TOTP code stays valid for about 90 seconds here, because one step either
  /// side is allowed for clock drift. Without this column the same six digits
  /// work repeatedly inside that window — so a code read over someone's
  /// shoulder, or captured by a proxy that relays it, can be used a second time
  /// by someone else.
  ///
  /// Any code from this period or earlier is refused, which makes each code
  /// single-use. Stored as the period start rather than the moment of use so
  /// the comparison is exact: two codes from the same period are the same code.
  totpLastUsedAt  DateTime?

  /// SMS CONTACT. Three columns, because "we have a number" and "we are
  /// allowed to text it" are different facts and conflating them is how an
  /// unverified number gets messaged.
  ///
  /// E.164, always — "+447700900123". Normalised on the way in so a number
  /// typed four different ways is one row, and so the provider is never handed
  /// something it has to guess about.
  ///
  /// UNIQUE, and this is a judgement call with a real cost. A verified phone
  /// is an identity signal, and one number verifying unlimited accounts
  /// destroys it — that is the abuse this prevents. The cost is that a number
  /// held by a suspended account cannot be reused by its owner elsewhere,
  /// which is a support ticket rather than a security hole. Postgres allows
  /// many NULLs in a unique column, so accounts without a number are
  /// unaffected.
  ///
  /// NEVER POPULATED FROM Address.phone. That field is a delivery contact for
  /// a parcel, unverified, and frequently a third party's number — see
  /// docs/adr/0027-notification-consent-and-preferences.md
  phone              String?             @unique
  /// Null until a code sent to that number came back. Nothing is EVER sent to
  /// a number whose value here is null; the column is the gate.
  phoneVerifiedAt    DateTime?
  /// When they agreed to be texted, recorded separately from verification
  /// because proving a number works is not the same as agreeing to receive
  /// messages on it — and it is the consent, not the verification, that has to
  /// be produced if anyone asks.
  smsConsentAt       DateTime?
  phoneVerifications PhoneVerification[]

  orders            Order[]
  wishlist          WishlistItem[]
  addresses         Address[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  pushSubscriptions PushSubscription[]
  reportsMade       Report[]                 @relation("ReportsMade")
  moderationActions ModerationAction[]       @relation("ModeratorActions")
  returnsRequested  ReturnRequest[]          @relation("ReturnBuyer")

  @@index([role])
  @@map("users")
}

/// Something that happened to this user, worth telling them about.
///
/// IN-APP ONLY, BY CHOICE
/// Email delivery exists (see lib/mailer.ts) but nothing here uses it. Sending
/// mail for every sale, shipment, and moderation decision needs per-type
/// preferences and an unsubscribe path first, or it becomes the reason people
/// filter this domain to spam. This table stays the source of truth; when mail
/// does go out, it reads from here rather than replacing it.
///
/// TITLE AND BODY ARE WRITTEN AT CREATION, NOT RENDERED LATER
/// Same reasoning as OrderItem's snapshots: "Cast iron skillet sold" has to
/// keep saying that after the listing is renamed, repriced, or deleted. A
/// notification that re-derives its own text can quietly rewrite history, and
/// a notification about a deleted thing would break entirely.
model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  title String
  body  String?
  /// Where to go when it's clicked. A plain path, so a moved route is a
  /// dead link rather than a crash.
  link  String?

  /// Null means unread. A nullable timestamp rather than a boolean, because
  /// "when did they see it" is worth having and costs nothing.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// The unread badge, and the list. Both read by user.
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A domain event, written in the SAME TRANSACTION as the notification above.
///
/// WHY THIS TABLE EXISTS
/// Delivering a notification by email, push, or SMS means publishing it
/// somewhere. Publishing from inside notify() would be a dual write: two
/// systems, no transaction spanning them, and no ordering of the two that
/// survives a crash in between. Row first, publish second, and the crash loses
/// the event with nothing recording that a publish was owed. Publish first, row
/// second, and a rolled-back transaction has already emailed somebody about a
/// sale that did not happen.
///
/// This row removes the gap: it commits with the notification or not at all,
/// and a relay publishes only what is already durable. Same discipline as
/// claim-then-charge — one system decides atomically, the external call comes
/// after. See docs/adr/0024-outbox-not-dual-writes.md
///
/// PUBLISHING IS AT-LEAST-ONCE, DELIBERATELY
/// The relay publishes and then sets publishedAt. A crash between those two
/// republishes on the next pass. That is the correct trade — a duplicate is
/// recoverable and a lost notification is not — and it is why consumers
/// deduplicate on eventId rather than trusting delivery.
/// See docs/adr/0026-delivery-idempotency.md
model OutboxEvent {
  id String @id @default(uuid())

  /// The consumer's dedupe key. Generated once, here, inside the transaction —
  /// never regenerated. Every republish by the relay and every redelivery by
  /// the broker carries this same value, which is the only reason deduplication
  /// downstream can work at all.
  eventId String @unique

  /// What this event is about. Not a foreign key: an event has to survive the
  /// thing it describes being deleted, the same reasoning as Report.targetId.
  aggregateType String
  aggregateId   String

  type NotificationType

  /// The partition key, denormalised so the relay never joins to find it.
  /// The relay's query has to stay a single index scan over unpublished rows.
  userId String

  /// What a channel worker needs in order to render and send: the notification
  /// id, its title, body, and link. A snapshot for the same reason the
  /// notification's own text is one — it must not re-derive from rows that may
  /// since have changed or gone.
  payload Json

  createdAt DateTime @default(now())

  /// Null means unpublished. This is the relay's entire working set, and the
  /// hand-added partial index in the migration is what keeps it cheap once the
  /// published rows outnumber the pending ones by a few orders of magnitude.
  publishedAt DateTime?

  /// Diagnostics for a row the relay keeps failing to publish. Written on a
  /// best-effort basis after a failed batch, outside the rolled-back
  /// transaction — so a broker outage is visible in the table rather than only
  /// in a log nobody is tailing.
  attempts  Int     @default(0)
  lastError String?

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// How one transfer to one seller went.
enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

/// One transfer to one seller, covering one or more delivered order items.
///
/// THE PAYOUT UNIT IS THE ORDER ITEM, NOT THE ORDER, because a basket can span
/// sellers (ADR 0014) and each line is shipped and refunded on its own. An
/// order with four sellers produces four payouts, on four different days.
///
/// CLAIMED BEFORE STRIPE IS CALLED, exactly as a charge is (ADR 0013) and a
/// refund is (ADR 0016). A read-then-transfer version lets two concurrent runs
/// both read the same balance and both send it, which for a $120 order means
/// $240 leaving the platform.
model Payout {
  id       String        @id @default(uuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// The sum of the items below, less any debt netted off at claim time.
  amountCents Int
  /// What was withheld from this payout to settle an earlier failed reversal.
  nettedCents Int    @default(0)
  currency    String @default("USD")

  status PayoutStatus @default(PENDING)

  /// A REFERENCE to Stripe's transfer, never a copy of its contents — the same
  /// rule as Order.paymentIntentId and Refund.providerRefundId.
  provider           String?
  providerTransferId String? @unique
  failureReason      String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  items PayoutItem[]

  @@index([sellerId, createdAt])
  @@index([status])
  @@map("payouts")
}

/// Which order items one payout covered, and for how much.
///
/// THE IDEMPOTENCY GUARD IS `orderItemId @unique`. An item can appear in at
/// most one payout, and a second attempt to include an already-paid item
/// collides at the database rather than relying on the code above it getting
/// the order of its checks right — the same discipline as the delivery
/// ledger's @@unique([eventId, channel]) in ADR 0026.
///
/// It also answers the question a seller actually asks — "what is this $84
/// for?" — because these rows name the exact lines.
model PayoutItem {
  id       String @id @default(uuid())
  payoutId String
  payout   Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  /// Not a foreign key relation on purpose: a payout statement has to stay
  /// readable after a listing is deleted, and OrderItem.listingId is already
  /// nullable for that reason.
  orderItemId String @unique

  /// Snapshotted, for the same reason the shipping address is copied onto an
  /// order: what the seller was paid must not change when a price does.
  amountCents Int

  /// Set when a refund arrived after this line had been paid and the transfer
  /// was reversed. Kept on the item rather than the payout because a refund is
  /// per line, so only part of a payout may come back.
  reversedAt         DateTime?
  providerReversalId String?

  @@index([payoutId])
  @@map("payout_items")
}

/// Money a seller owes back, because a refund arrived after they were paid and
/// the transfer could not be reversed.
///
/// The honest floor of a feature nobody wants to build: it is netted off the
/// seller's next payout and nothing else happens. No invoice, no collections. A
/// seller who never sells again keeps it, and that is a stated consequence in
/// ADR 0030 rather than an oversight — recording who owes what is still far
/// better than a platform silently absorbing it.
model PayoutDebt {
  id       String        @id @default(uuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String @default("USD")
  reason      String

  /// The line that caused it, for tracing. Not a relation, same reasoning as
  /// PayoutItem.orderItemId.
  orderItemId String?

  createdAt DateTime  @default(now())
  /// Null until a later payout has absorbed it.
  settledAt DateTime?

  @@index([sellerId, settledAt])
  @@map("payout_debts")
}

/// Where a notification can be sent, beyond the app itself.
enum DeliveryChannel {
  EMAIL
  PUSH
  SMS
}

/// How one delivery went.
///
/// SUPPRESSED IS AN OUTCOME, NOT AN ABSENCE. A message not sent because the
/// recipient turned that channel off is recorded rather than dropped. Without
/// the row, "why did I not get an email about my refund?" can only be answered
/// by reasoning about what the preferences WOULD have evaluated to at a past
/// moment, from preferences that have since been edited.
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
  /// Not sent yet, and not a failure: quiet hours. The row carries notBefore
  /// and a sweeper picks it up once that passes. Distinct from SUPPRESSED
  /// because SUPPRESSED is terminal — collapsing the two would mean the only
  /// honest thing to tell somebody at 8am is that their notification was
  /// dropped at 3am.
  DEFERRED
}

/// Which channels actually delivered one event, and what the provider said.
///
/// KAFKA AND THE OUTBOX BOTH DELIVER AT LEAST ONCE, BY DESIGN.
/// The relay publishes and then marks publishedAt, so a crash between the two
/// republishes. A consumer that sends and then dies before committing its
/// offset reprocesses on restart. A rebalance during a deploy hands a partition
/// back at the last committed offset. All three are ordinary operational
/// events, not failures — exactly as Stripe webhook redeliveries are.
///
/// The unique constraint below is what stops any of them becoming a second
/// email, or a second SMS to somebody's phone at 3am. The row is inserted
/// BEFORE the provider is called, so the insert IS the claim: same discipline
/// as claiming an order before charging it. Checking first and inserting after
/// would reintroduce the read-then-write race of ADR 0012.
///
/// See docs/adr/0026-delivery-idempotency.md
model NotificationDelivery {
  id      String          @id @default(uuid())
  /// Matches OutboxEvent.eventId. Not a foreign key: a delivery record must
  /// outlive the outbox row, which is pruned once published.
  eventId String
  channel DeliveryChannel
  status  DeliveryStatus  @default(PENDING)

  /// Who it went to, for the admin panel's "did they get it?" question.
  userId String

  /// The notification this delivered, kept so a support query can join the two.
  notificationId String?

  /// A REFERENCE to the provider's message, never its content. Same rule as the
  /// payment and KYC fields: this table records that something was sent, not
  /// what it said.
  providerMessageId String?

  attempts       Int     @default(0)
  lastError      String?
  /// Why nothing was sent. Set when status is SUPPRESSED, and also when
  /// DEFERRED — in that case it names the window that is holding it.
  suppressReason String?

  /// The earliest this may be sent. Only set when status is DEFERRED.
  ///
  /// A timestamp rather than a flag, because the sweeper's whole query is
  /// "what is due now". A flag would make it "what is deferred, then work out
  /// which of those are due" — a scan that grows with everything ever
  /// deferred rather than with what is actually owed.
  notBefore DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  /// THE IDEMPOTENCY GUARD. A redelivery collides here and stops.
  @@unique([eventId, channel])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  /// The sweeper's query, and the only reason it does not scan the table.
  @@index([status, notBefore])
  @@map("notification_deliveries")
}

/// A code sent to a phone, to prove whoever holds the account holds the number.
///
/// MIRRORS EmailVerificationToken DELIBERATELY — hashed, single-use, expiring —
/// with three differences, each forced by the fact that this is six digits and
/// not 32 random bytes.
///
/// SHORTER EXPIRY. An email link needs an inbox to reach. An SMS code appears
/// on a lock screen, readable by anyone holding the handset, so it lives for
/// minutes rather than a day.
///
/// AN ATTEMPT COUNTER. A 32-byte token cannot be guessed; a six-digit code is
/// one of a million, and a few thousand tries would find it. The counter caps
/// the guesses against ONE code, and the rate limiter caps how fast codes can
/// be requested — both are needed, because either alone leaves a way through.
///
/// THE NUMBER LIVES HERE, NOT ON User, UNTIL IT IS PROVEN. Writing the number
/// to User at request time would mean an unverified number sitting in the field
/// that governs delivery, one bug away from being texted.
model PhoneVerification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The E.164 number this code was sent to, held here until it is proven.
  phone    String
  /// SHA-256, like every other token in this schema. A code readable from a
  /// database dump is a code that can be used from one.
  codeHash String

  /// Wrong guesses against THIS code. Past the cap the row is spent, so
  /// guessing costs a fresh code and therefore a fresh rate-limit slot.
  attempts Int @default(0)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
  @@map("phone_verifications")
}

/// An explicit opt-in or opt-out, per event type per channel.
///
/// ABSENT MEANS "USE THE DEFAULT FOR THIS TYPE" — see lib/channelPolicy.ts.
/// Storing only the deviations is what keeps a new NotificationType from
/// needing a backfill across every user before it can be sent at all, and stops
/// 11 x 3 rows per account existing purely to say "they never opened settings".
///
/// PER TYPE AND PER CHANNEL, NOT PER CHANNEL ALONE. A single "email me" switch
/// is too coarse in a way that matters: somebody who finds review notifications
/// noisy would turn email off, and that same switch carries REFUND_ISSUED. The
/// setting that solves a minor annoyance would silently disable the notice
/// about their money.
///
/// See docs/adr/0027-notification-consent-and-preferences.md
model NotificationPreference {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  channel DeliveryChannel
  enabled Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

/// A browser that agreed to receive push notifications.
///
/// ONE ROW PER BROWSER PROFILE, NOT PER USER. Somebody signed in on a laptop
/// and a phone has two, and both should ring. A row per user would silently
/// mean "the last device that subscribed", and the failure — notifications
/// going to the device you are not holding — is invisible from the server.
///
/// WEB PUSH RATHER THAN FCM OR APNs
/// There is no mobile app: no store listing, no native build, no signing
/// certificates. Web Push works in the browser that is already open, and the
/// same subscription covers desktop and Android. iOS supports it for pages
/// added to the home screen, which is the honest limit of this approach.
///
/// NOTHING HERE IS A SECRET OF OURS. `endpoint`, `p256dh` and `auth` are issued
/// by the browser's own push service and are useless without the VAPID private
/// key, which lives in the environment and never in this database.
model PushSubscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service's URL for this browser. Unique because a browser
  /// regenerates its subscription on resubscribe, and a stale duplicate would
  /// deliver the same notification twice to one device.
  endpoint String @unique
  /// The browser's public key and auth secret, for payload encryption.
  p256dh   String
  auth     String

  /// Only to make a device list legible ("Chrome on Windows"). Never parsed
  /// for behaviour — user agents lie, and a notification that renders
  /// differently per browser string is a bug waiting to happen.
  userAgent String?

  createdAt  DateTime @default(now())
  /// Touched on every successful send, so a device list can show what is live.
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// Someone flagging something.
///
/// The target is a type plus a bare id, NOT a foreign key. A report has to
/// survive the thing it reported being removed — which is frequently the whole
/// point of the report — and three nullable FKs would be worse than one id.
model Report {
  id         String @id @default(uuid())
  reporterId String
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  /// The reporter's own words. This is what a moderator actually reads.
  detail     String?

  status     ReportStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  /// One open report per person per thing, so a single upset user cannot
  /// inflate a queue by reporting the same listing eleven times. Enforced in
  /// the app: Prisma cannot express `WHERE status = 'OPEN'`.
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

/// What a moderator did.
///
/// Retained rather than overwritten, for the same reason KycAttempt is: a
/// decision to remove someone's listing or suspend their account has to be
/// explainable afterwards, including when it was wrong.
model ModerationAction {
  id          String @id @default(uuid())
  moderatorId String
  moderator   User   @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)

  action     ModerationActionType
  targetType ReportTargetType
  targetId   String
  /// Free text. Shown to the affected user, so it has to be readable.
  reason     String
  /// The report this came from, if any. Direct actions have none.
  reportId   String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("moderation_actions")
}

/// Where someone's orders get delivered.
///
/// SOFT DELETE, AND SNAPSHOTS ON ORDERS
/// This row is the buyer's *current* address book entry. It is never referenced
/// by a past order — orders copy the fields onto themselves at checkout, the
/// same way OrderItem copies title and price. Editing your address next year
/// must not rewrite where a parcel was sent last year, and deleting it must not
/// leave an order pointing at nothing.
///
/// Deleted entries are kept because the buyer may be mid-checkout when they
/// press delete, and because a removed address is not something anyone needs to
/// destroy.
model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Free-form on purpose. Address formats differ enough by country that
  /// structured fields beyond this cause more bad data than they prevent.
  fullName String
  line1    String
  line2    String?
  city     String
  /// State, province, or county. Optional — plenty of countries have no such thing.
  region   String?
  postcode String
  /// ISO 3166-1 alpha-2.
  country  String
  phone    String?

  /// At most one per user, enforced in the app inside a transaction — Prisma
  /// cannot express a partial unique index on `isDefault = true`.
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("addresses")
}

/// A saved listing.
///
/// Deliberately the opposite of a Reservation: no quantity, no expiry, and no
/// effect whatsoever on availability. Saving something must never take it out
/// of the shop, or two people saving the same chair would each think they had
/// claimed it.
///
/// The compound unique is what makes saving idempotent — a double-tapped heart,
/// or the same listing opened in two tabs, cannot produce two rows. The app
/// relies on that rather than checking first and inserting after, which is the
/// same read-then-write race as ADR 0012.
model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  /// Ordered newest-first per user, which is the only way this is ever read.
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

/// A time-limited hold on a listing's stock, taken before checkout.
///
/// This exists because almost everything here is quantity 1, so the hard
/// problem is not counting stock — it is making sure two buyers can never both
/// claim the same object. Availability is decided under a row lock on the
/// listing; see docs/adr/0012-row-locking-for-reservations.md
model Reservation {
  id         String            @id @default(uuid())
  listingId  String
  listing    Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity   Int
  status     ReservationStatus @default(HELD)
  /// Holds are deliberately short-lived so abandoned checkouts return stock.
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  /// A partial unique index enforces one HELD hold per buyer per listing.
  /// Prisma can't express `WHERE status = 'HELD'`, so it's added by hand in the
  /// migration — a plain @@unique would also constrain RELEASED rows and stop a
  /// buyer ever re-reserving the same item.
  @@index([listingId, status])
  @@index([expiresAt])
  @@index([userId])
  @@map("reservations")
}

/// One-to-one with User, created when someone starts selling. Kept separate
/// from User so identity-verification and payout state don't bloat the row
/// every auth request reads.
model SellerProfile {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName String
  bio      String?

  /// Identity verification is a REFERENCE to a provider's result — never the
  /// document itself. Storing raw government ID images or numbers would make
  /// this table a breach target and pull it under special-category data rules
  /// (GDPR, India's DPDP Act). We keep only what we need to prove state.
  kycStatus          VerificationStatus @default(UNSTARTED)
  kycProvider        String?
  kycSessionId       String?
  kycDocType         String?
  kycCountry         String?
  kycVerifiedAt      DateTime?
  kycRejectionReason String?

  /// Gated by kycStatus. Following the Stripe Connect model: you may list
  /// items unverified, but money cannot move to you until identity clears.
  /// OUR gate: set only from a recorded identity decision. See ADR 0007 and
  /// lib/verification.ts, which is the single place allowed to write it.
  payoutsEnabled Boolean @default(false)

  /// STRIPE'S gate, mirrored from the connected account's `payouts_enabled`
  /// capability by the account.updated webhook.
  ///
  /// TWO FLAGS, NOT ONE, AND THEY ANSWER DIFFERENT QUESTIONS.
  /// payoutsEnabled is "is this person who they say they are", which is a
  /// moderation decision this platform owns. This one is "will Stripe move
  /// money to that bank account" — sanctions screening, tax status, bank
  /// details — which this platform cannot overrule and must not try to.
  ///
  /// Collapsing them would mean one of two failures: paying out to an account
  /// Stripe will reject, or letting a payments provider quietly reinstate a
  /// seller that moderation had blocked. Both must be true before a transfer
  /// is attempted. See docs/adr/0030-payout-eligibility-and-hold.md
  payoutsReady Boolean @default(false)

  /// The connected account. Unique because two sellers sharing one payout
  /// destination is either a mistake or fraud, and the constraint is the only
  /// thing that would notice.
  connectAccountId   String?   @unique
  connectOnboardedAt DateTime?

  payouts Payout[]
  debts   PayoutDebt[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  listings    Listing[]
  kycAttempts KycAttempt[]
  sales       OrderItem[]
  threads     MessageThread[]
  placements  PlacementRequest[]

  @@map("seller_profiles")
}

/// Audit trail of identity-verification attempts. Identity checks are exactly
/// the kind of decision that has to be explainable after the fact, so each
/// attempt is retained rather than overwritten — SellerProfile keeps only the
/// current state for fast reads.
///
/// Like SellerProfile, this stores a REFERENCE to the provider's decision and
/// never any part of the document: no image, no document number, no date of
/// birth. Those pass through memory and are discarded.
model KycAttempt {
  id                String             @id @default(uuid())
  sellerProfileId   String
  sellerProfile     SellerProfile      @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)
  provider          String
  providerSessionId String             @unique
  status            VerificationStatus @default(PENDING)
  documentType      String?
  country           String?
  rejectionReason   String?
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([sellerProfileId])
  @@map("kyc_attempts")
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String
  coverImage  String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  listings    Listing[]

  @@map("categories")
}

model Listing {
  id          String @id @default(uuid())
  slug        String @unique
  title       String
  description String

  sellerId   String
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id])

  condition     Condition
  /// The seller's own phrasing ("Needs a tune-up", "Varies by piece"). This is
  /// what renders on the card; `condition` is what powers filtering.
  conditionNote String?

  /// Money is stored as integer minor units. Never floats — 0.1 + 0.2 problems
  /// have no place in a price column.
  priceCents         Int
  originalPriceCents Int?
  currency           String @default("USD")

  /// Defaults to 1: most secondhand goods are unique. Present because a seller
  /// may genuinely have several identical pieces.
  quantity Int           @default(1)
  status   ListingStatus @default(DRAFT)

  /// Merchandising flag for the "Picked for you" shelf. This is hand-curation,
  /// not personalisation — there is no recommendation engine behind it, and
  /// naming it `featured` keeps that honest at the data layer.
  featured Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — a listing referenced by a past order must never vanish.
  deletedAt DateTime?

  images       ListingImage[]
  reviews      Review[]
  reservations Reservation[]
  orderItems   OrderItem[]
  wishlistedBy WishlistItem[]
  placements   PlacementRequest[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([featured])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  /// 0 is the cover image.
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_images")
}

/// Ratings shown in the UI are computed from these rows, not stored as a
/// number on the listing. A listing with no reviews honestly shows none.
model Review {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Whole stars, 1-5. Enforced in the app layer.
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, authorId])
  @@index([listingId])
  @@map("reviews")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@map("email_verification_tokens")
}

/// A live credential emailed to somebody who cannot sign in.
///
/// Mirrors EmailVerificationToken deliberately — same hashing, same single-use
/// rule — with one difference that matters: a MUCH shorter life. A verification
/// link only proves an inbox exists; a reset link *is* the account until it is
/// used, so it gets one hour rather than twenty-four.
///
/// Only the hash is stored. A database leak must not hand over working reset
/// links for every account that happens to have one outstanding.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Set the moment it is redeemed. Single-use, so a link forwarded, logged by
  /// a mail scanner, or sitting in a browser history cannot be replayed.
  usedAt    DateTime?

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?

  @@index([userId])
  @@map("refresh_tokens")
}

/// A purchase. Created from the buyer's live holds, so the stock is already
/// committed before payment is attempted — the alternative is telling someone
/// their item is gone after they have paid.
model Order {
  id        String      @id @default(uuid())
  /// Short human-facing reference for support conversations.
  reference String      @unique
  buyerId   String
  buyer     User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(PENDING_PAYMENT)

  /// Integer minor units, like every other money column here.
  subtotalCents Int
  currency      String @default("USD")

  /// A REFERENCE to the payment, never card data. Same reasoning as the KYC
  /// fields: the provider holds anything sensitive.
  /// See docs/adr/0013-payment-provider-seam.md
  paymentProvider String?
  paymentIntentId String?   @unique
  paidAt          DateTime?
  failureReason   String?

  /// HOW MUCH HAS GONE BACK, in the same minor units as subtotalCents.
  ///
  /// Denormalised on purpose. It is not a display convenience — it is the
  /// column the over-refund guard reads. Issuing a refund is a conditional
  /// UPDATE of the form "add X only if refundedCents + X <= subtotalCents",
  /// which is the same claim-then-charge discipline payment uses, for the same
  /// reason: two concurrent refund requests must not both reach the provider.
  /// Summing the refund rows per request could not be made atomic that way.
  ///
  /// A PAID order with refundedCents > 0 is a partial refund, and is a normal
  /// expected state — a basket can span sellers, and one seller failing to send
  /// does not undo the others. status only becomes REFUNDED once the whole
  /// subtotal has gone back.
  refundedCents Int @default(0)

  /// WHERE THIS WAS SENT — a snapshot, not a relation.
  ///
  /// Copied from the buyer's Address at checkout for the same reason
  /// OrderItem copies title and price: they can edit or delete that address
  /// afterwards, and an order has to keep saying where it actually went.
  /// A foreign key would let last year's parcel silently move house.
  ///
  /// Nullable only because orders predating addresses exist.
  shipToName     String?
  shipToLine1    String?
  shipToLine2    String?
  shipToCity     String?
  shipToRegion   String?
  shipToPostcode String?
  shipToCountry  String?
  shipToPhone    String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  refunds   Refund[]
  returns   ReturnRequest[]

  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

/// Money sent back, and why.
///
/// APPEND-ONLY, like ModerationAction and KycAttempt
/// A refund is a financial event. Rows are never edited except to move status
/// off PENDING, because "we returned $32 on the 4th because the seller could
/// not post it" has to still be answerable a year later — including, and
/// especially, when somebody disputes it.
///
/// PER LINE, NOT PER ORDER
/// orderItemId is nullable so a moderator can refund an order as a whole, but
/// the ordinary case names the line: a basket can span several sellers, and one
/// seller failing to send says nothing about the others. Refunding the whole
/// order there would take money from sellers who did their part.
///
/// THE AMOUNT IS SNAPSHOTTED
/// Not derived from the line at read time, for the same reason OrderItem copies
/// title and price. What was actually returned is a fact about the past, and it
/// must not move when anything else does.
model Refund {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Which line this was for. Null means the order as a whole.
  orderItemId String?

  amountCents Int
  currency    String @default("USD")

  status  RefundStatus  @default(PENDING)
  trigger RefundTrigger

  /// Shown to the buyer verbatim. Required, for the same reason a moderation
  /// action's reason is: money moving with no stated cause is unanswerable.
  reason String

  /// Who pressed the button. Null for automatic refunds, which are attributable
  /// to the seller action recorded on the order line instead.
  initiatedById String?

  /// A REFERENCE to the provider's refund, never card data.
  /// See docs/adr/0013-payment-provider-seam.md
  provider         String?
  providerRefundId String? @unique
  /// Why the provider refused. Null unless status is FAILED.
  failureReason    String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
  @@map("refunds")
}

/// One line of an order.
///
/// Title, price, and seller are SNAPSHOTS taken at purchase time, not lookups.
/// A seller can rename or reprice a listing afterwards, and an order has to keep
/// saying what was actually bought for what — otherwise order history silently
/// rewrites itself.
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Kept so the buyer can still reach the product page. Nullable because a
  /// listing may later be hard-deleted, and the order must survive that.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  /// WHO SOLD IT.
  ///
  /// Without this a seller cannot answer "what did I sell?" — the line carried
  /// only a `sellerName` string, which is a snapshot for display and not
  /// something to query by. This was the single reason sellers were blind to
  /// their own orders.
  ///
  /// Nullable and SetNull so closing a shop does not delete a buyer's receipt.
  /// Going through the listing instead would not work: a listing can be
  /// hard-deleted, and then the sale would lose its seller too.
  sellerId String?
  seller   SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  title          String
  unitPriceCents Int
  quantity       Int
  sellerName     String

  /// Fulfilment is per line, because a basket can span several sellers and two
  /// sellers cannot share one parcel.
  fulfilment     FulfilmentStatus @default(UNFULFILLED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  carrier        String?
  trackingNumber String?
  /// Why the seller could not send it. Shown to the buyer verbatim.
  fulfilmentNote String?

  @@index([orderId])
  /// The seller sales view: their lines, newest first.
  @@index([sellerId, fulfilment])
  @@map("order_items")
}

/// A buyer asking for their money back on one line.
///
/// A REQUEST, NOT A REFUND, and a separate table for that reason: a refund is
/// money moving, and this is a question that may be answered no. Putting a
/// status on Refund instead would make a refused return indistinguishable from
/// a FAILED refund in the one table the finance view reads, and would force the
/// over-refund guard — a conditional UPDATE on Order.refundedCents — to start
/// reasoning about refunds that were only ever asked for.
///
/// See docs/adr/0031-buyer-initiated-returns.md
model ReturnRequest {
  id String @id @default(uuid())

  /// UNIQUE, and this single index is what makes the flow safe under a double
  /// tap: the insert IS the claim, exactly as with PayoutItem.orderItemId.
  /// The second concurrent request collides here rather than opening a rival
  /// request against the same line.
  ///
  /// Not a relation, for the same reason PayoutItem.orderItemId is not: a
  /// return has to stay readable after a listing is deleted, and it is also
  /// what lets the unique constraint stand alone.
  orderItemId String @unique

  /// Denormalised so the buyer's own returns can be listed without joining
  /// through order items, and so the request survives the line being reshaped.
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Who asked. Always the buyer on the order.
  buyerId String
  buyer   User   @relation("ReturnBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  status ReturnStatus @default(OPEN)

  /// The buyer's own words, shown to the seller and any moderator verbatim.
  /// Required for the same reason a refund's reason is: a decision with no
  /// stated cause is unanswerable.
  reason String

  /// Whether the buyer says the item was misdescribed rather than simply
  /// unwanted. Recorded because the help page draws that distinction and it is
  /// what would decide who pays return postage — nothing acts on it yet, which
  /// needs the carrier integration ADR 0031 declined.
  notAsDescribed Boolean @default(false)

  /// The answer, in the answerer's words. Required to refuse or reject.
  decisionNote String?
  /// The seller's user id, or the moderator's. Null while OPEN.
  decidedById  String?
  decidedAt    DateTime?

  /// The refund this produced. Set only on APPROVED, and unique so one request
  /// can never be credited twice.
  refundId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The buyer's own list, newest first.
  @@index([buyerId, createdAt])
  /// The seller and admin queues: everything awaiting an answer.
  @@index([status, createdAt])
  @@index([orderId])
  @@map("return_requests")
}

/// Where a paid placement can appear. Typed, because the two slots are worth
/// different amounts and because a type lets the live-slot claim be expressed
/// as a constraint rather than as application logic (ADR 0034).
enum PlacementSlot {
  /// One at a time: the banner at the top of the homepage.
  HERO
  /// Four positions on the "Picked for you" shelf.
  PICKED_SHELF
}

/// A placement is a negotiation before it is a booking, so most of these states
/// describe whose turn it is rather than where the listing appears.
enum PlacementStatus {
  REQUESTED /// The seller asked. Nobody has answered.
  COUNTERED /// A moderator proposed different terms. Back with the seller.
  AGREED    /// Both sides agreed. Not on the homepage yet.
  LIVE      /// On the homepage now. Claimed — see `placement_live_slot`.
  ENDED     /// The agreed period ran out. Terminal.
  DECLINED  /// A moderator said no. Terminal.
  WITHDRAWN /// The seller pulled the request. Terminal.
}

enum ThreadKind {
  /// Carries a PlacementRequest negotiation.
  PLACEMENT
  /// Anything else a seller wants to raise.
  SUPPORT
}

enum MessageAuthor {
  SELLER
  /// The moderator ROLE, not a particular person. ADR 0033 explains why the
  /// admin side of a thread is not a user id.
  ADMIN
}

/// A conversation between one seller and whichever moderator is reading.
model MessageThread {
  id       String        @id @default(uuid())
  sellerId String
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  kind    ThreadKind
  subject String

  /// Denormalised so the thread list sorts by activity without touching
  /// `messages`. Written in the same transaction as the message it describes.
  lastMessageAt DateTime  @default(now())
  closedAt      DateTime?

  /// Two counters rather than a row per message per reader: there are exactly
  /// two sides and one of them is a role, so "has the admin side read this" is
  /// one fact. The cost — two moderators cannot be told apart — is accepted and
  /// recorded in ADR 0033.
  sellerUnread Int @default(0)
  adminUnread  Int @default(0)

  messages  Message[]
  placement PlacementRequest?

  createdAt DateTime @default(now())

  @@index([sellerId, lastMessageAt])
  /// The moderator queue: threads with something unanswered, oldest first.
  @@index([adminUnread, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id       String        @id @default(uuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  author MessageAuthor

  /// NOT a foreign key, deliberately. "An admin who has since been deleted
  /// wrote this" has to stay a true and answerable statement — the same
  /// decision, for the same reason, as notification_deliveries (ADR 0026).
  authorUserId String?

  body      String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("messages")
}

/// A seller asking to appear on the homepage, and the answer.
///
/// NO MONEY MOVES HERE. `agreedCents` is what both sides settled on, not
/// something the platform can collect: there is no seller-to-platform charge in
/// this application and ADR 0034 records why that boundary was drawn.
model PlacementRequest {
  id        String        @id @default(uuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  slot PlacementSlot
  /// 0 for HERO, 0-3 for the shelf. Half of the live-slot claim.
  position Int @default(0)

  /// Whole cents, like every other amount in this schema (ADR 0005).
  offeredCents Int
  agreedCents  Int?

  startsAt DateTime?
  endsAt   DateTime?

  status PlacementStatus @default(REQUESTED)

  /// No FK, same reasoning as Message.authorUserId.
  decidedById String?
  decidedAt   DateTime?

  /// The conversation the negotiation happened in. One thread per request, so
  /// the counter-offers and the record of what was agreed cannot drift apart.
  threadId String        @unique
  thread   MessageThread @relation(fields: [threadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// What the homepage reads, and what the moderator queue reads.
  @@index([status, slot, position])
  @@index([sellerId, status])
  @@map("placement_requests")
}
